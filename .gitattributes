# Normalize text files to LF in the repo and on checkout, on every OS. The
# source is LF already, so this stops the CRLF round-trip warnings on Windows.
* text=auto eol=lf

# Binary assets: leave the bytes alone, never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.bin   binary
